# Outreach environment variables.
#
# Copy to `.env` and fill in real values for local development:
#     cp .env.example .env
# `.env` is git-ignored, but it is still plaintext: keep it local, restrict
# its file permissions, and never attach or commit it.
#
# In cloud deploys the values come from SSM Parameter Store (see
# docs/cloud-architecture.md — `/outreach/<name>`), injected at container
# startup. The ENVIRONMENT variable MUST be set to `production` in cloud
# so the server hard-fails on missing secrets rather than falling back
# to dev defaults.

# ---------------------------------------------------------------------------
# Core — required in production, optional in dev
# ---------------------------------------------------------------------------

# Deployment environment. Local dev leaves this unset (defaults to 'dev').
# Set to 'production' in the cloud entrypoint.
ENVIRONMENT=dev

# Postgres connection string. Required in production. In dev, falls back to
# config.yaml `database_url`, then to postgresql://pipeline:pipeline@localhost:5432/outreach.
DATABASE_URL=postgresql://pipeline:pipeline@localhost:5432/outreach

# JWT signing key for session cookies. Required in production. In dev, a
# warning is emitted and an insecure default is used.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Set to true only when serving over HTTPS (production). Controls the
# `Secure` flag on the session cookie.
COOKIE_SECURE=false

# Frontend origin(s) allowed to make credentialed requests. Localhost:3000
# is added automatically in dev — don't include it here.
FRONTEND_URL=http://localhost:3000

# Optional: comma-separated additional CORS origins (for staging + preview
# domains). Ignored in dev when FRONTEND_URL already matches.
# CORS_EXTRA_ORIGINS=https://preview.example.com,https://staging.example.com

# ---------------------------------------------------------------------------
# External API credentials
# ---------------------------------------------------------------------------

# HubSpot private app token — read-only except for email send.
HUBSPOT_TOKEN=

# LLM selection. Format: '<provider>:<model>'. graph/agent.py picks the
# matching langchain integration at import time, so only the chosen
# provider's API key below actually needs to be populated.
# Examples:
#   openai:gpt-4.1-mini
#   google_genai:gemini-2.5-flash-lite
OUTREACH_MODEL=openai:gpt-4.1-mini

# Populate the key for whichever provider OUTREACH_MODEL points at.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# LangSmith tracing (optional).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=outreach

# ---------------------------------------------------------------------------
# Organization profile
# ---------------------------------------------------------------------------

# These optional overrides take precedence over the `organization` section in
# config.yaml. Comma-separated values are accepted for domains and relevance
# terms. Leave them commented to use the fictional defaults.
# OUTREACH_ORGANIZATION_NAME=Example Company
# OUTREACH_ORGANIZATION_DESCRIPTION=a provider of wireless transport and private-network infrastructure
# OUTREACH_PRIMARY_DOMAINS=example.com
# OUTREACH_RESOURCE_DOMAINS=example.com
# OUTREACH_RELEVANCE_TERMS=wireless,microwave,backhaul,private network,connectivity
# OUTREACH_COMPANY_FIT_GUIDANCE=Prioritize organizations that operate distributed or mission-critical networks.

# JSON object keyed by stable product-family IDs. Regex backslashes must be
# escaped for JSON. See docker/config.default.yaml for the readable YAML form.
# OUTREACH_PRODUCT_FAMILIES_JSON={"mesh_radio":{"display_name":"mesh radio","aliases":["mesh radio","mesh node"],"patterns":["MESH-(?:NODE|BASE)(?:-[A-Z0-9]+)?"],"url_patterns":["mesh[-_]?radio"]}}

# ---------------------------------------------------------------------------
# Google OAuth — only used when a real domain + HTTPS are available
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Fully-qualified HTTPS callback URL registered in Google Console.
# Derived from the request if unset — works locally, fails behind a proxy.
# GOOGLE_CALLBACK_URL=https://your-domain.example/auth/callback
